  "components": {
    "schemas": {
      "spot_depth": {
        "type": "object",
        "required": [
          "t",
          "available_at",
          "venue",
          "asset",
          "bid_price",
          "ask_price",
          "mid_price",
          "bid_0_100",
          "ask_0_100",
          "bid_100_200",
          "ask_100_200",
          "bid_200_300",
          "ask_200_300",
          "bid_300_500",
          "ask_300_500",
          "bid_500_750",
          "ask_500_750",
          "observed_bid_bps",
          "observed_ask_bps",
          "trusted_bid_bps",
          "trusted_ask_bps",
          "captured_at",
          "status",
          "source",
          "quality_json",
          "revision"
        ],
        "properties": {
          "t": {
            "type": "integer",
            "minimum": 0,
            "multipleOf": 60000
          },
          "available_at": {
            "type": [
              "integer",
              "null"
            ]
          },
          "venue": {
            "type": "string",
            "enum": [
              "binance",
              "coinbase",
              "kraken",
              "bitfinex"
            ]
          },
          "asset": {
            "type": "string",
            "enum": [
              "BTC",
              "ETH",
              "SOL"
            ]
          },
          "bid_price": {
            "type": [
              "number",
              "null"
            ]
          },
